# Extraction API base. Defaults to the public instance when unset.
WAVY_API_BASE=https://wavy.netraux.eu.cc

# Override if ffmpeg is not on PATH (used only by the "convert to MP3" button).
FFMPEG_PATH=ffmpeg

# Origin allow-list for the API routes (403 for anything else).
# MUST match your public site URL. Unset = https://linzy.web.id
ALLOWED_ORIGIN=https://linzy.web.id

# Shared secret for non-browser clients (curl/scripts). Browsers pass via
# Origin; everything else must send `x-api-fingerprint` header.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Unset = fingerprint check disabled (dev only — set it in production!)
API_FINGERPRINT=
